{
  "name": "cc-hp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "admin": "node server/admin.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "VITE_STATIC_MODE=true VITE_BASE_PATH=/Cc-Hp/ vite build",
    "test:pages": "npm run build:pages && playwright test --config playwright.pages.config.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.0",
    "vite": "^7.2.2"
  }
}
